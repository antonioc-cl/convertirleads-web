---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'Diagnóstico y consultoría de marketing en Chile — convertirLeads',
  description = 'Diagnóstico digital y consultoría de marketing para empresas que ya gastan en web, ads o SEO y necesitan saber qué funciona, qué no y qué arreglar primero.',
  canonical = 'https://convertirleads.cl/',
  noindex = false,
} = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://convertirleads.cl/#person',
      name: 'Antonio Correa',
      jobTitle: 'Consultor de marketing y estratega digital',
      url: 'https://convertirleads.cl',
      sameAs: [
        'https://www.linkedin.com/in/antoniocorreas/',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Puerto Varas',
        addressRegion: 'Los Lagos',
        addressCountry: 'CL',
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://convertirleads.cl/#organization',
      name: 'convertirLeads',
      alternateName: 'Antonio Correa · convertirLeads',
      url: 'https://convertirleads.cl',
      logo: 'https://convertirleads.cl/images/logo/convertirleads_primary_color_transparent.svg',
      founder: { '@id': 'https://convertirleads.cl/#person' },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Los Lagos' },
        { '@type': 'Country', name: 'Chile' },
      ],
      serviceType: [
        'Diagnóstico digital',
        'Consultoría de marketing',
        'Auditoría SEO y AEO',
        'Estrategia digital',
        'Optimización de conversión',
        'CRM y automatización',
        'Landing pages de conversión',
      ],
      priceRange: '$$$',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://convertirleads.cl/#website',
      url: 'https://convertirleads.cl',
      name: 'convertirLeads',
      inLanguage: 'es-CL',
      publisher: { '@id': 'https://convertirleads.cl/#organization' },
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description: description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://convertirleads.cl/#website' },
      about: { '@id': 'https://convertirleads.cl/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://convertirleads.cl/',
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    <meta name="theme-color" content="#322f3e" />
    <meta name="author" content="Antonio Correa" />

    <!-- Performance: preconnect external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://plausible.io" />
    <link rel="dns-prefetch" href="https://cal.com" />

    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://convertirleads.cl/images/og-image.png" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="convertirLeads" />
    <meta property="article:author" content="Antonio Correa" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://convertirleads.cl/images/og-image.png" />
    <meta name="twitter:creator" content="@antoniocorrea" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-paper text-ink font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-ink focus:text-paper focus:px-4 focus:py-2">Saltar al contenido</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!-- Scroll to top -->
    <button
      id="scroll-top"
      aria-label="Volver arriba"
      class="fixed bottom-6 right-6 z-50 flex h-12 w-12 translate-y-24 items-center justify-center border border-mist bg-paper text-ink shadow-md transition-all duration-300 hover:bg-paper-warm focus-visible:outline focus-visible:outline-2 focus-visible:outline-sage"
    >
      ↑
    </button>
    <script is:inline>
      (function() {
        const btn = document.getElementById('scroll-top');
        if (!btn) return;
        const update = function() {
          btn.classList.toggle('translate-y-24', window.scrollY < 500);
        };
        window.addEventListener('scroll', update, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        update();
      })();
    </script>
  </body>
</html>
