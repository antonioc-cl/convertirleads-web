---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada — convertirLeads</title>
    <script defer data-domain="convertirleads.cl" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="min-h-screen bg-ink text-paper font-sans">
    <main class="mx-auto flex min-h-screen max-w-[760px] flex-col justify-center px-6 py-20 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-sage">404</p>
      <h1 class="mt-6 font-serif text-[clamp(48px,8vw,92px)] leading-[0.96] tracking-[-0.025em] text-paper">Página no encontrada</h1>
      <p class="mt-6 max-w-prose text-lg leading-relaxed text-paper/80">Lo que buscas no está aquí. Tal vez nunca existió, o se movió.</p>
      <a href="/" class="mt-10 w-fit text-lg text-terracotta no-underline hover:text-terracotta-dark">Volver al inicio →</a>
    </main>
  </body>
</html>
