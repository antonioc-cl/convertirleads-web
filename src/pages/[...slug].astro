---
import { getCollection, render } from 'astro:content';
import Landing from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AeoAnswerBlock from '../components/seo/AeoAnswerBlock.astro';
import AuthorEntityBox from '../components/seo/AuthorEntityBox.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import InternalLinkCluster from '../components/seo/InternalLinkCluster.astro';
import PrimaryCta from '../components/seo/PrimaryCta.astro';

const slugFromId = (id: string) => id.replace(/\.mdx?$/, '');

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = slugFromId(entry.id);
const { Content } = await render(entry);

const { title, description, h1, type, city, region, noindex, answer, faqs, updated, ctaLabel, ctaHref, internalLinks } = entry.data;

const canonical = `https://convertirleads.cl/${slug}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://convertirleads.cl/' },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};

const serviceSchema = type === 'service' ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: title,
  description: description,
  url: canonical,
  provider: { '@id': 'https://convertirleads.cl/#organization' },
  areaServed: city ? { '@type': 'City', name: city } : { '@type': 'Country', name: 'Chile' },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Empresas que ya invierten en marketing, web, ads, SEO o CRM y necesitan diagnosticar qué funciona',
  },
} : null;

const articleSchema = ['aeo', 'compare'].includes(type) ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'es-CL',
  author: { '@id': 'https://convertirleads.cl/#person' },
  publisher: { '@id': 'https://convertirleads.cl/#organization' },
  dateModified: updated?.toISOString(),
} : null;

const faqSchema = faqs?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const defaultInternalLinks = [
  { href: '/diagnostico-digital/', label: 'Diagnóstico digital' },
  { href: '/consultoria-marketing-digital/', label: 'Consultoría de marketing' },
  { href: '/auditoria-seo-aeo/', label: 'Auditoría SEO/AEO' },
  { href: '/estrategia-digital/', label: 'Estrategia digital' },
  ...(type !== 'geo' ? [{ href: '/consultor-marketing-digital-chile/', label: 'Consultor de marketing en Chile' }] : []),
];

const relatedLinks = internalLinks?.length ? internalLinks : defaultInternalLinks;
---

<Landing title={title} description={description} canonical={canonical} noindex={Boolean(noindex)}>
  <Header slot="header" />

  <section class="relative z-[1] bg-paper">
    <div class="page-shell mx-auto max-w-[1240px]">

      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex gap-2 font-mono text-xs tracking-[0.05em] text-stone">
          <li><a href="/" class="no-underline hover:text-ink">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-soft">{title.split(' — ')[0]}</li>
        </ol>
      </nav>

      <!-- Hero de landing -->
      <div class="reveal mb-16">
        {city && (
          <div class="eyebrow mb-4">
            {type === 'geo' ? `${city}${region ? `, ${region}` : ''}` : 'Servicio'}
          </div>
        )}
        <h1 class="max-w-[1050px] font-serif text-[clamp(32px,6vw,80px)] leading-[0.96] tracking-[-0.025em] text-ink">
          {h1}
        </h1>
      </div>

      <AeoAnswerBlock answer={answer} />

      <PrimaryCta label={ctaLabel} href={ctaHref} event="seo_cta_above_fold_click" />

      <!-- Contenido -->
      <div class="reveal prose-content max-w-[720px]">
        <Content />
      </div>

      <AuthorEntityBox />
      <FaqSection faqs={faqs} />
      <PrimaryCta label={ctaLabel} href={ctaHref} />
      <InternalLinkCluster links={relatedLinks} />
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Landing>
