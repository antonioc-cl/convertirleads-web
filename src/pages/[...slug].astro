---
import { getCollection, render } from 'astro:content';
import Landing from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const slugFromId = (id: string) => id.replace(/\.mdx?$/, '');

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = slugFromId(entry.id);
const { Content } = await render(entry);

const { title, description, h1, type, city, region, noindex, answer, faqs, updated } = entry.data;

const canonical = `https://convertirleads.cl/${slug}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://convertirleads.cl/' },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};

const serviceSchema = type === 'service' ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: title,
  description: description,
  url: canonical,
  provider: { '@id': 'https://convertirleads.cl/#organization' },
  areaServed: city ? { '@type': 'City', name: city } : { '@type': 'Country', name: 'Chile' },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Empresas que ya invierten en marketing, web, ads, SEO o CRM y necesitan diagnosticar qué funciona',
  },
} : null;

const articleSchema = ['aeo', 'compare'].includes(type) ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'es-CL',
  author: { '@id': 'https://convertirleads.cl/#person' },
  publisher: { '@id': 'https://convertirleads.cl/#organization' },
  dateModified: updated?.toISOString(),
} : null;

const faqSchema = faqs?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;
---

<Landing title={title} description={description} canonical={canonical} noindex={Boolean(noindex)}>
  <Header slot="header" />

  <section class="relative z-[1] bg-paper">
    <div class="page-shell mx-auto max-w-[1240px]">

      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex gap-2 font-mono text-xs tracking-[0.05em] text-stone">
          <li><a href="/" class="no-underline hover:text-ink">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-soft">{title.split(' — ')[0]}</li>
        </ol>
      </nav>

      <!-- Hero de landing -->
      <div class="reveal mb-16">
        {city && (
          <div class="eyebrow mb-4">
            {type === 'geo' ? `${city}${region ? `, ${region}` : ''}` : 'Servicio'}
          </div>
        )}
        <h1 class="max-w-[1050px] font-serif text-[clamp(32px,6vw,80px)] leading-[0.96] tracking-[-0.025em] text-ink">
          {h1}
        </h1>
      </div>

      {answer && (
        <aside class="reveal mb-12 max-w-[860px] border-l-4 border-sage bg-paper-warm p-6 md:p-8" aria-label="Respuesta breve">
          <p class="mb-3 font-mono text-xs uppercase tracking-[0.14em] text-sage-deep">Respuesta breve</p>
          <p class="text-lg leading-relaxed text-ink md:text-xl">{answer}</p>
        </aside>
      )}

      <!-- Contenido -->
      <div class="reveal prose-content max-w-[720px]">
        <Content />
      </div>

      {faqs?.length && (
        <section class="reveal mt-16 max-w-[860px] border-t border-mist pt-10" aria-labelledby="faq-landing">
          <p class="mb-3 font-mono text-xs uppercase tracking-[0.14em] text-sage-deep">FAQ</p>
          <h2 id="faq-landing" class="font-serif text-[clamp(30px,4vw,48px)] leading-tight text-ink">Preguntas frecuentes</h2>
          <div class="mt-6 space-y-0">
            {faqs.map((faq, index) => (
              <details class="group border-b border-mist">
                <summary class="flex cursor-pointer items-start justify-between gap-6 py-5 list-none">
                  <span class="font-mono text-xs text-sage-deep mt-1">/{String(index + 1).padStart(2, '0')}</span>
                  <span class="flex-1 font-serif text-xl leading-tight text-ink">{faq.question}</span>
                  <span class="text-lg text-stone group-open:hidden">+</span>
                  <span class="hidden text-lg text-stone group-open:block">−</span>
                </summary>
                <div class="pb-6 pl-12">
                  <p class="max-w-[680px] text-base leading-relaxed text-ink-soft md:text-lg">{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- CTA final de landing -->
      <div class="reveal mt-16 border-t border-mist pt-10">
        <div class="flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-8">
          <a href="/agendar" class="bg-terracotta px-8 py-5 text-sm font-medium text-ink no-underline transition-colors hover:bg-terracotta-dark">
            Solicitar diagnóstico →
          </a>
          <span class="text-sm text-stone">
            30 min · sin costo · sin venta
          </span>
        </div>
      </div>

      <!-- Cross-links -->
      <div class="reveal mt-12 border-t border-mist pt-8">
        <p class="font-mono text-xs tracking-[0.1em] text-stone mb-4">También podría interesarte:</p>
        <div class="flex flex-wrap gap-4">
          <a href="/diagnostico-digital/" class="text-sm text-ink no-underline transition-colors hover:text-sage-deep">
            Diagnóstico digital →
          </a>
          <a href="/consultoria-marketing-digital/" class="text-sm text-ink no-underline transition-colors hover:text-sage-deep">
            Consultoría de marketing →
          </a>
          <a href="/auditoria-seo-aeo/" class="text-sm text-ink no-underline transition-colors hover:text-sage-deep">
            Auditoría SEO/AEO →
          </a>
          <a href="/estrategia-digital/" class="text-sm text-ink no-underline transition-colors hover:text-sage-deep">
            Estrategia digital →
          </a>
          {type !== 'geo' && (
            <a href="/consultor-marketing-digital-chile/" class="text-sm text-ink no-underline transition-colors hover:text-sage-deep">
              Consultor de marketing en Chile →
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Landing>
