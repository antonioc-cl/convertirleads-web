---
import Landing from '../layouts/Landing.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Landing title="Solicitar diagnóstico — convertirLeads" description="Agenda una llamada inicial de 30 minutos para evaluar si tiene sentido partir con diagnóstico digital o consultoría." canonical="https://convertirleads.cl/agendar/" noindex>
  <Header slot="header" />
  <section class="relative z-[1] bg-paper">
    <div class="page-shell mx-auto max-w-[1240px]">
      <div class="eyebrow mb-6">diagnóstico inicial</div>
      <h1 class="max-w-[800px] font-serif text-[clamp(32px,5vw,64px)] leading-[0.96] tracking-[-0.025em] text-ink">
        30 minutos para entender si el diagnóstico tiene sentido.
      </h1>
      <p class="mt-6 max-w-[560px] text-lg leading-relaxed text-ink-soft">
        Levanto qué estás invirtiendo hoy, qué no está claro y si soy la persona correcta para ayudarte. Si no lo soy, te lo digo y te ahorro la conversación.
      </p>

      <!-- Cal.com inline embed -->
      <div
        class="mt-10 min-h-[600px] border border-mist bg-paper p-2"
        data-seo-event="seo_calendar_click"
        data-seo-label="Cal.com embed"
        data-seo-destination="https://cal.com/antonio-developer/30min"
      >
        <div id="cal-booking-place" style="width:100%;min-height:600px;"></div>
        <script type="text/javascript">
          (function (C, A, L) {
            let p = function (a, ar) { a.q.push(ar); };
            let d = C.document;
            C.Cal = C.Cal || function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement('script')).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () { p(api, arguments); };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === 'string') {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ['initNamespace', namespace]);
                } else {
                  p(cal, ar);
                }
                return;
              }
              p(cal, ar);
            };
          })(window, 'https://app.cal.com/embed/embed.js', 'init');

          Cal('init', '30min', { origin: 'https://cal.com' });
          Cal.ns['30min']('inline', {
            elementOrSelector: '#cal-booking-place',
            calLink: 'antonio-developer/30min',
            config: { layout: 'month_view' },
          });
          Cal.ns['30min']('ui', {
            hideEventTypeDetails: false,
            layout: 'month_view',
            styles: { branding: { brandColor: '#322f3e' } },
          });
        </script>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Landing>
