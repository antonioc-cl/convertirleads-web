---
import type { CollectionEntry } from 'astro:content';

interface Props {
  cases: CollectionEntry<'cases'>[];
}

const { cases } = Astro.props;
const onlyPlaceholders = cases.length === 0 || cases.every((item) => String(item.data.year).toLowerCase() === 'pendiente');
---

<section id="casos" class="relative z-[1] bg-paper-warm">
  <div class="section-shell">
  <div class="reveal mb-12 border-b-4 border-double border-ink pb-5">
    <div class="eyebrow mb-3">05 · proyectos</div>
    <h2 class="font-serif text-[clamp(32px,4.5vw,56px)] leading-none tracking-[-0.02em] text-ink">
      En reposicionamiento. Sin humo.
    </h2>
  </div>

  {onlyPlaceholders ? (
    <div class="reveal">
      <div class="grid gap-10 border-b border-mist pb-12 md:grid-cols-2 md:gap-12">
        <div class="space-y-5 text-lg leading-relaxed text-ink-soft">
          <p>
            Las métricas reales de mis proyectos las publico apenas tenga permiso del cliente o el caso esté completamente anonimizado. <strong class="font-semibold text-ink">No invento gráficos para llenar espacio.</strong>
          </p>
          <p>
            Mientras tanto, hay un dossier privado para fundadores que estén evaluando trabajar conmigo.
          </p>
        </div>
        <aside class="bg-ink p-8 text-paper">
          <div class="mb-5 border-b border-paper/15 pb-4 font-mono text-xs uppercase tracking-[0.15em] text-sage">→ acceso privado</div>
          <h3 class="font-serif text-xl leading-tight text-paper">Dossier completo con métricas y aprendizajes.</h3>
          <p class="mt-4 text-sm leading-relaxed text-paper/75">Tres a cinco casos detallados — incluyendo proyectos que no funcionaron como esperábamos. Lo comparto a fundadores y equipos que estén evaluando trabajar conmigo.</p>
          <a href="/contacto?context=dossier" class="mt-6 inline-flex bg-terracotta px-6 py-3 text-sm font-medium text-ink no-underline hover:bg-terracotta-dark">Solicitar dossier →</a>
        </aside>
      </div>
    </div>
  ) : (
    <div class="grid gap-px border border-mist bg-mist md:grid-cols-3">
      {cases.map((item, index) => (
        <article class="reveal bg-paper p-7">
          <span class="font-mono text-xs tracking-[0.12em] text-sage-deep">caso /{String(index + 1).padStart(2, '0')} · {item.data.year}</span>
          <h3 class="mt-4 font-serif text-2xl text-ink">{item.data.industry}</h3>
          <dl class="mt-6 space-y-4 text-sm leading-relaxed text-ink-soft">
            <div><dt class="font-mono text-xs uppercase tracking-[0.12em] text-stone">Problema</dt><dd>{item.data.problem}</dd></div>
            <div><dt class="font-mono text-xs uppercase tracking-[0.12em] text-stone">Hallazgo</dt><dd>{item.data.finding}</dd></div>
            <div><dt class="font-mono text-xs uppercase tracking-[0.12em] text-stone">Cambio</dt><dd>{item.data.change}</dd></div>
            <div><dt class="font-mono text-xs uppercase tracking-[0.12em] text-stone">Resultado</dt><dd>{item.data.result}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  )}
  </div>
</section>
