---
const problems = [
  {
    num: '/01',
    title: 'Mi sitio se ve bien\npero no convierte.',
    copy: 'Bonito sin estrategia. Hecho sin hablar con un cliente real. Hecho sin medir nada.',
  },
  {
    num: '/02',
    title: 'Tengo tráfico,\npero no clientes.',
    copy: 'Si no entiendes qué quiere tu cliente, lo que llega son curiosos.',
  },
  {
    num: '/03',
    title: 'Pago ads\ny no sé si funcionan.',
    copy: 'Sin analítica ni atribución, los ads son una rifa cara.',
  },
];
---

<section class="relative z-[1] bg-paper">
  <div class="hero-shell">

    <div class="reveal">
      <img id="hero-logo" src="/images/logo/convertirleads_compact_color_transparent.svg" alt="convertirLeads" class="mb-6 h-10 w-auto md:mb-8 md:h-14 transition-opacity duration-300" />
      <div id="hero-eyebrow" class="eyebrow mb-8 inline-flex items-center gap-3 transition-opacity duration-300 md:mb-10">
        <span class="h-px w-7 bg-sage-deep" aria-hidden="true"></span>
        Desde el sur de Chile
      </div>

      <h1 class="max-w-[1050px] font-serif text-[clamp(32px,7vw,104px)] leading-[0.96] tracking-[-0.025em] text-ink">
        Diagnóstico y consultoría<br />para saber qué marketing<br /><span class="highlight">sí funciona.</span>
      </h1>
    </div>

    <!-- CTA móvil -->
    <div class="reveal mt-8 flex flex-col gap-4 md:hidden">
      <a href="/agendar" class="bg-terracotta px-6 py-4 text-center text-sm font-medium text-ink no-underline transition-colors hover:bg-terracotta-dark">
        Solicitar diagnóstico →
      </a>
      <a href="/contacto" class="text-center text-xs text-stone no-underline hover:text-ink">o parte por escrito →</a>
    </div>

    <div class="reveal mt-8 md:mt-12">
      <p class="max-w-[620px] text-base leading-relaxed text-ink-soft md:text-lg">
        Para empresas que ya invierten en web, ads, SEO o CRM y necesitan detectar dónde pierden plata, qué corregir primero y qué proveedor realmente aporta. <strong class="font-semibold text-ink">Una persona con criterio. Sin agencia.</strong>
      </p>

      <!-- CTA desktop -->
      <div class="hidden mt-8 md:flex md:flex-col md:items-start md:gap-4">
        <a href="/agendar" class="bg-terracotta px-8 py-5 text-sm font-medium text-ink no-underline transition-colors hover:bg-terracotta-dark">
          Solicitar diagnóstico →
        </a>
        <span class="font-mono text-xs tracking-[0.05em] text-stone">→ 30 min · sin costo · sin venta</span>
        <a href="/contacto" class="text-xs text-stone no-underline hover:text-ink">O parte por escrito →</a>
      </div>
    </div>

    <!-- Problemas: compacto en mobile -->
    <div class="reveal mt-10 border-t border-mist pt-8 md:mt-16 md:border-none md:pt-0">
      <h2 class="sr-only">Problemas que resolvemos</h2>

      <!-- Mobile: accordion compacto -->
      <details class="group md:hidden border border-mist bg-paper" open>
        <summary class="flex cursor-pointer items-center justify-between p-4 list-none">
          <span class="font-mono text-xs text-ink-soft">¿Te identificas con alguno? →</span>
          <span class="text-lg group-open:hidden">+</span>
          <span class="hidden text-lg group-open:block">−</span>
        </summary>
        <div class="border-t border-mist p-4 pt-3 space-y-4">
          {problems.map((problem) => (
            <div>
              <h3 class="font-serif text-base text-ink">"{problem.title}"</h3>
              <p class="mt-1 text-xs leading-relaxed text-ink-soft">{problem.copy}</p>
            </div>
          ))}
        </div>
      </details>

      <!-- Desktop: grid horizontal -->
      <div class="hidden grid-cols-3 gap-px border border-mist bg-mist md:grid">
        {problems.map((problem) => (
          <article class="bg-paper p-6 hover:bg-paper-warm lg:p-8">
            <span class="font-mono text-xs tracking-[0.12em] text-sage-deep">{problem.num}</span>
            <h3 class="mt-3 whitespace-pre-line font-serif text-lg leading-tight tracking-[-0.005em] text-ink">"{problem.title}"</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{problem.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
