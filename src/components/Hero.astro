---
const problems = [
  {
    num: '/01',
    title: 'Mi sitio se ve bien\npero no convierte.',
    copy: 'Bonito sin estrategia. Hecho sin hablar con un cliente real. Hecho sin medir nada.',
  },
  {
    num: '/02',
    title: 'Tengo tráfico,\npero no clientes.',
    copy: 'Si no entiendes qué quiere tu cliente, lo que llega son curiosos.',
  },
  {
    num: '/03',
    title: 'Pago ads\ny no sé si funcionan.',
    copy: 'Sin analítica ni atribución, los ads son una rifa cara.',
  },
];
---

<section class="relative z-[1] overflow-hidden bg-paper">
  <div class="hero-shell">
    <div class="hero-copy reveal">
      <img id="hero-logo" src="/images/logo/convertirleads_compact_color_transparent.svg" alt="convertirLeads" class="mb-6 h-10 w-auto transition-opacity duration-300 md:mb-8 md:h-14" />
      <div id="hero-eyebrow" class="eyebrow mb-8 inline-flex items-center gap-3 transition-opacity duration-300 md:mb-10">
        <span class="h-px w-7 bg-sage-deep" aria-hidden="true"></span>
        Desde el sur de Chile
      </div>

      <h1 class="hero-title font-serif leading-[0.94] tracking-[-0.032em] text-ink">
        <span class="block">Diagnóstico y consultoría</span>
        <span class="block">para saber qué marketing</span>
        <span class="block"><span class="highlight">sí funciona.</span></span>
      </h1>

      <p class="mt-8 max-w-[680px] text-base leading-relaxed text-ink-soft md:mt-10 md:text-lg">
        Para empresas que ya invierten en web, ads, SEO o CRM y necesitan detectar dónde pierden plata, qué corregir primero y qué proveedor realmente aporta. <strong class="font-semibold text-ink">Una persona con criterio. Sin agencia.</strong>
      </p>

      <div class="mt-8 flex flex-col items-start gap-4 md:mt-10">
        <a
          href="/agendar"
          class="bg-terracotta px-8 py-5 text-sm font-medium text-ink no-underline transition-colors hover:bg-terracotta-dark"
          data-seo-event="seo_cta_agendar_click"
          data-seo-label="Solicitar diagnóstico hero"
          data-seo-destination="/agendar/"
        >
          Solicitar diagnóstico →
        </a>
        <span class="font-mono text-xs tracking-[0.05em] text-stone">→ 30 min · sin costo · sin venta</span>
        <a
          href="/contacto"
          class="text-xs text-stone no-underline hover:text-ink"
          data-seo-event="seo_cta_contacto_click"
          data-seo-label="O parte por escrito hero"
          data-seo-destination="/contacto/"
        >O parte por escrito →</a>
      </div>
    </div>

    <aside class="hero-figure reveal" aria-hidden="true">
      <div class="diagnostic-mark">
        <div class="diagnostic-label">Mapa de pérdida</div>
        <div class="diagnostic-board">
          <span class="diag-node diag-node-web">WEB</span>
          <span class="diag-node diag-node-ads">ADS</span>
          <span class="diag-node diag-node-seo">SEO</span>
          <span class="diag-node diag-node-crm">CRM</span>
          <span class="diag-ring"></span>
          <span class="diag-cut diag-cut-a"></span>
          <span class="diag-cut diag-cut-b"></span>
          <span class="diag-axis diag-axis-x"></span>
          <span class="diag-axis diag-axis-y"></span>
        </div>
        <div class="diagnostic-caption">
          <span>/01</span>
          <span>encontrar dónde se escapa la venta</span>
        </div>
      </div>
    </aside>

    <div class="hero-problems reveal">
      <h2 class="sr-only">Problemas que resolvemos</h2>

      <details class="group border border-mist bg-paper md:hidden">
        <summary class="flex cursor-pointer items-center justify-between p-4 list-none">
          <span class="font-mono text-xs text-ink-soft">¿Te identificas con alguno? →</span>
          <span class="text-lg group-open:hidden">+</span>
          <span class="hidden text-lg group-open:block">−</span>
        </summary>
        <div class="border-t border-mist p-4 pt-3 space-y-4">
          {problems.map((problem) => (
            <div>
              <h3 class="font-serif text-base text-ink">"{problem.title}"</h3>
              <p class="mt-1 text-xs leading-relaxed text-ink-soft">{problem.copy}</p>
            </div>
          ))}
        </div>
      </details>

      <div class="hidden grid-cols-3 gap-px border border-mist bg-mist md:grid">
        {problems.map((problem) => (
          <article class="bg-paper p-6 transition-colors hover:bg-paper-warm lg:p-8">
            <span class="font-mono text-xs tracking-[0.12em] text-sage-deep">{problem.num}</span>
            <h3 class="mt-3 whitespace-pre-line font-serif text-lg leading-tight tracking-[-0.005em] text-ink">"{problem.title}"</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{problem.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
