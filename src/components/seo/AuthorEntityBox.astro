---
interface Props {
  showImage?: boolean;
}

const { showImage = true } = Astro.props;
---

<aside class:list={["reveal", "author-card", !showImage && "author-card--no-image"]} aria-label="Autoría y criterio">
  {showImage && (
    <div class="author-card__media">
      <img
        src="/images/antonio-correa.png"
        alt="Antonio Correa, consultor de marketing digital en Chile"
        width="220"
        height="220"
        loading="lazy"
      />
    </div>
  )}
  <div class="author-card__content">
    <p class="author-card__eyebrow">Quién revisa</p>
    <h2>Antonio Correa · ConvertirLeads</h2>
    <p>
      Consultor de marketing y estratega digital desde Puerto Varas. Trabajo con empresas que ya invierten en marketing, web, ads, SEO o CRM y necesitan separar actividad de decisiones útiles.
    </p>
    <a
      href="https://www.linkedin.com/in/antoniocorreas/"
      target="_blank"
      rel="noopener noreferrer"
      data-seo-event="seo_internal_link_click"
      data-seo-label="LinkedIn Antonio Correa"
      data-seo-destination="https://www.linkedin.com/in/antoniocorreas/"
    >
      Ver LinkedIn →
    </a>
  </div>
</aside>
