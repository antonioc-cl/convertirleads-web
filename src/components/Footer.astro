---
const footerLinks = [
  { href: '/diagnostico-digital/', label: 'Diagnóstico' },
  { href: '/consultoria-marketing-digital/', label: 'Consultoría' },
  { href: '/auditoria-seo-aeo/', label: 'SEO/AEO' },
  { href: '/estrategia-digital/', label: 'Estrategia' },
  { href: '/llms.txt', label: 'llms.txt' },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative z-[1] border-t border-paper/10 bg-ink px-6 py-8 md:px-8">
  <div class="mx-auto max-w-[1240px]">
    <nav class="mb-4 flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      {footerLinks.map((link) => (
        <a class="text-xs text-paper/50 no-underline transition-colors hover:text-sage" href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between font-mono text-xs tracking-[0.05em] text-paper/60">
      <span>© {currentYear} ConvertirLeads</span>
      <a href="https://www.linkedin.com/in/antoniocorreas/" target="_blank" rel="noopener noreferrer" class="text-paper/50 no-underline transition-colors hover:text-sage">LinkedIn →</a>
      <span>Desde Puerto Varas, Los Lagos. X Región, Chile</span>
    </div>
  </div>
</footer>
